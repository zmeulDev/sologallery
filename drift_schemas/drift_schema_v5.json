  "fixed_sql": [
    {
      "name": "favorites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"asset_id\" TEXT NOT NULL, \"favorited_at\" INTEGER NOT NULL, PRIMARY KEY (\"asset_id\"));"
        }
      ]
    },
    {
      "name": "albums",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"albums\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"cover_asset_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"sort_index\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "album_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"album_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"album_id\" INTEGER NOT NULL REFERENCES albums (id) ON DELETE CASCADE, \"asset_id\" TEXT NOT NULL, \"added_at\" INTEGER NOT NULL, UNIQUE (\"album_id\", \"asset_id\"));"
        }
      ]
    },
    {
      "name": "edit_instructions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"edit_instructions\" (\"asset_id\" TEXT NOT NULL, \"instructions_json\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"asset_id\"));"
        }
      ]
    },
    {
      "name": "photo_assets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photo_assets\" (\"asset_id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"is_video\" INTEGER NOT NULL CHECK (\"is_video\" IN (0, 1)), \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"is_dated\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_dated\" IN (0, 1)), \"indexed_at\" INTEGER NULL, PRIMARY KEY (\"asset_id\"));"
        }
      ]
    },
    {
      "name": "photo_labels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photo_labels\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"asset_id\" TEXT NOT NULL REFERENCES photo_assets (asset_id) ON DELETE CASCADE, \"label\" TEXT NOT NULL, \"confidence\" REAL NOT NULL);"
        }
      ]
    },
    {
      "name": "photo_texts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photo_texts\" (\"asset_id\" TEXT NOT NULL REFERENCES photo_assets (asset_id) ON DELETE CASCADE, \"content\" TEXT NOT NULL, PRIMARY KEY (\"asset_id\"));"
        }
      ]
    },
    {
      "name": "persons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"persons\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"display_name\" TEXT NULL, \"cover_asset_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "face_embeddings",
      "sql": [
