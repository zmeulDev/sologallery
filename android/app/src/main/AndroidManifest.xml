<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Photo library access (photo_manager). Read-only (images + videos).
         Android 13+ (API 33) uses the granular media permissions; API 34+ adds
         the "selected photos" (limited) grant; API <=32 falls back to the
         legacy storage read. No network permissions — see CLAUDE.md
         Absolute rules (zero network calls). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- EXIF GPS for the detail viewer's Location chip. Android 10+ redacts
         location out of the photo bytes handed to an app unless it holds this,
         so `AssetEntity.latlngAsync()` returns nothing without it and the chip
         is silently always empty (integration_test/detail_actions_test.dart
         asserts otherwise). It reads coordinates already inside the user's own
         photos, on device — it grants no positioning access and makes no
         network call. photo_manager only asks for it when the request opts in,
         see PhotoLibraryService's PermissionRequestOption. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- video_player_android (media3) declares INTERNET + ACCESS_NETWORK_STATE
         for network/adaptive streaming; we only ever play local files, so strip
         both from the merged manifest to keep the release build network-free
         (Absolute rules / Definition of Done #5). media3 degrades gracefully to
         no network monitoring for local playback. WAKE_LOCK (keep the screen on
         during playback) is left in place. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- google_mlkit_image_labeling pulls Play-Services / Firebase-IID
         transitively, which inject a Firebase Cloud Messaging (push) permission
         and receiver. The bundled labeling model runs fully on-device with no
         network, so strip both to keep the release build network-free (Absolute
         rules / Definition of Done #5). Re-verify the merged manifest after any
         ML Kit dep bump. -->
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove" />
    <!-- The face-detection / tflite dependency chain (Play-Services / gms) also
         injects READ_PHONE_STATE and WRITE_EXTERNAL_STORAGE. Neither is needed —
         all ML is on-device and originals are never written — and READ_PHONE_STATE
         fails the privacy check (Absolute rules / DoD #5). Strip both. Re-verify
         the merged manifest after any ML/tflite dep bump. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- photo_manager declares the legacy storage read for API <=32. minSdk is
         35, so no device this installs on can ever reach it — strip it rather
         than let a dead storage permission show up in the Play listing for an
         app whose whole pitch is that it takes nothing. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- Auto Backup is off: with it on (the platform default) Android uploads
         app_flutter/sologallery.sqlite — the photo index, including face
         embeddings and OCR text — to the user's Google account, which would
         break the zero-network / 100%-local guarantee (CLAUDE.md Absolute
         rules). The two rule files exclude everything as a second line of
         defence if backup is ever re-enabled. -->
    <application
        android:label="SoloGallery"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <!-- enableOnBackInvokedCallback is explicitly false, not just
             omitted: on a Samsung SM-S938B (One UI) with this Flutter
             engine (3.44.6), enabling the predictive-back callback let
             Android's own default OnBackInvokedCallback re-register
             itself as "top" over FlutterActivity's the instant the
             window gained input focus (confirmed in logcat:
             setTopOnBackInvokedCallback alternates FlutterActivity$1 ->
             Activity$$ExternalSyntheticLambda0 on every cold launch,
             before any navigation), permanently shadowing it — every back
             press then invoked Android's callback (which just finishes
             the Activity), and PopScope in app_shell.dart never saw the
             event at all. Forcing the legacy dispatch path instead routes
             back presses through Flutter's Navigator/PopScope correctly
             (verified: Saved/Search/Albums back now returns to Library;
             Library itself still exits as normal) — the only cost is
             losing the animated predictive-back preview. Re-test before
             flipping this back to true on any Flutter/AGP upgrade. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="false">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Strip the Firebase Cloud Messaging receiver pulled in transitively by
             ML Kit (see the c2dm permission note above) — push messaging is
             never used; on-device labeling needs no network component. -->
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            tools:node="remove" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
