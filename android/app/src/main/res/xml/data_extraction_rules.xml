<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) replacement for full-backup-content. Same intent as
     backup_rules.xml: the on-device photo index is never included in a cloud
     backup, and never transferred device-to-device. See CLAUDE.md Absolute
     rules (zero network calls, 100% local). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
