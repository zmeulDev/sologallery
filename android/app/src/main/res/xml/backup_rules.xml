<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup is disabled outright (android:allowBackup="false"), so nothing
     here should ever be consulted. It exists as a second line of defence: if
     backup is ever re-enabled by accident or by a manifest merge, the photo
     index must still never leave the device (CLAUDE.md Absolute rules — zero
     network, 100% local). The index holds face embeddings, OCR text, and
     labels derived from the user's library. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
